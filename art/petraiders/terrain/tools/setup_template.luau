--[[
	Pet Raiders hub - terrain setup
	Run once in Roblox Studio AFTER importing PetRaiders_Heightmap.png + PetRaiders_Colormap.png
	(Terrain Editor > Create > Import, Position (@@IMPORT_POS@@), Size (@@IMPORT_SIZE@@)).
	Run it from the Command Bar (View > Command Bar) or with the Studio MCP "run_code" tool.
	Safe to re-run: it rebuilds its own two folders and changes nothing else in the place.

	What it does
	  1. Finds the imported terrain, measures the ground height and works out which way round the
	     import landed (it compares the terrain materials with the design, so mirrored/rotated
	     imports still get correct markers).
	  2. Recolours the terrain materials to the pastel palette used by the cube pets.
	  3. Checks that every path, station pad and egg pad is paved, flat and connected, and paints
	     any grass voxels it finds on a path centre line as Pavement.
	  4. Adds Workspace.PetRaidersLayout: a labelled pad marker for each station and egg pad,
	     with attributes (WorldX, WorldZ, GroundY, YawDeg, FacingX, FacingZ, ...) for snapping models.
	  5. Adds Workspace.PetRaidersBoundary: invisible walls just outside the play area.
	Generated by make_setup_lua.py from layout.json - edit CONFIG below, not the data tables.
]]

local CONFIG = {
	PASTEL_COLORS = true, -- recolour terrain materials to match the cube pets (prints the old colours)
	GRASS_BLADES = false, -- Terrain.Decoration (animated grass blades); off = clean low-poly look
	MARKERS = true, -- labelled layout markers for placing the buildings
	BOUNDARY_WALLS = true, -- invisible walls so players stay in the hub
	BOUNDARY_HALF = 335, -- walls this far from the centre (the play area edge is at 300)
	WALL_HEIGHT = 400,
	PAINT_PATH_GAPS = true, -- repaint grass found on a path centre line as Pavement
}

local PASTEL = {
	Grass = Color3.fromRGB(124, 200, 106),
	LeafyGrass = Color3.fromRGB(104, 178, 92),
	Pavement = Color3.fromRGB(226, 214, 192),
	Cobblestone = Color3.fromRGB(205, 190, 165),
	Ground = Color3.fromRGB(176, 128, 88),
	Rock = Color3.fromRGB(165, 156, 182),
	Snow = Color3.fromRGB(246, 248, 255),
}

-- ------------------------------------------------------------------ design data (studs; X east, Z south)
local STATIONS = {
--@@STATIONS@@
}

local EGG_PADS = {
--@@EGGPADS@@
}

-- path centre lines sampled every 4 studs: { x1, z1, x2, z2, ... }
local PATHS = {
--@@PATHS@@
}

-- expected material every @@GRID_STEP@@ studs over the play area ('.' = skipped, near an edge)
-- g Grass, p Pavement, c Cobblestone, d Ground (dirt)
local GRID = {
	step = @@GRID_STEP@@,
	half = @@GRID_HALF@@,
	rows = {
--@@GRID@@
	},
}

-- ------------------------------------------------------------------ helpers
local terrain = workspace.Terrain
local CHS = game:GetService("ChangeHistoryService")
local lines = {}
local function out(fmt, ...)
	local s = select("#", ...) > 0 and string.format(fmt, ...) or fmt
	table.insert(lines, s)
	print(s)
end

local recording
pcall(function()
	recording = CHS:TryBeginRecording("PetRaiders terrain setup")
end)
if not recording then
	pcall(function()
		CHS:SetWaypoint("Before PetRaiders terrain setup")
	end)
end
local function finish()
	if recording then
		pcall(function()
			CHS:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
		end)
	else
		pcall(function()
			CHS:SetWaypoint("PetRaiders terrain setup")
		end)
	end
	return table.concat(lines, "\n")
end

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.FilterDescendantsInstances = { terrain }
params.IgnoreWater = true

local function probe(x, z)
	local r = workspace:Raycast(Vector3.new(x, 2000, z), Vector3.new(0, -4000, 0), params)
	if r then
		return r.Position.Y, r.Material
	end
	return nil, nil
end

local CODE = {
	[Enum.Material.Grass] = "g",
	[Enum.Material.LeafyGrass] = "l",
	[Enum.Material.Pavement] = "p",
	[Enum.Material.Cobblestone] = "c",
	[Enum.Material.Ground] = "d",
	[Enum.Material.Rock] = "r",
	[Enum.Material.Snow] = "s",
}
local WALKABLE = { p = true, c = true, d = true }

local function rgb(c)
	return string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

out("=== Pet Raiders terrain setup ===")

-- ------------------------------------------------------------------ 1. orientation + ground height
local TRANSFORMS = {
	{ "as designed (image top = north / -Z)", function(x, z) return x, z end },
	{ "mirrored east-west (X flipped)", function(x, z) return -x, z end },
	{ "mirrored north-south (Z flipped)", function(x, z) return x, -z end },
	{ "rotated 180 degrees", function(x, z) return -x, -z end },
	{ "transposed (X and Z swapped)", function(x, z) return z, x end },
	{ "rotated 90 degrees", function(x, z) return -z, x end },
	{ "rotated -90 degrees", function(x, z) return z, -x end },
	{ "anti-transposed", function(x, z) return -z, -x end },
}

local n = #GRID.rows
local observed, hits = {}, 0
for j = 1, n do
	local row = {}
	local z = -GRID.half + (j - 1) * GRID.step
	for i = 1, n do
		local x = -GRID.half + (i - 1) * GRID.step
		local y, m = probe(x, z)
		if y then
			hits += 1
			row[i] = CODE[m] or "?"
		else
			row[i] = " "
		end
	end
	observed[j] = row
end
if hits < n * n * 0.5 then
	out("STOP: no terrain found over most of the play area (%d of %d probes hit terrain).", hits, n * n)
	out("Import PetRaiders_Heightmap.png + PetRaiders_Colormap.png first (Terrain Editor > Create > Import,")
	out("Position (@@IMPORT_POS@@), Size (@@IMPORT_SIZE@@)), then run this again.")
	return finish()
end

local function cell(v)
	return math.floor((v + GRID.half) / GRID.step + 0.5) + 1
end
local results = {}
for t, T in ipairs(TRANSFORMS) do
	local total, ok, ptotal, pok = 0, 0, 0, 0
	for j = 1, n do
		local row = GRID.rows[j]
		local z = -GRID.half + (j - 1) * GRID.step
		for i = 1, n do
			local e = string.sub(row, i, i)
			if e ~= "." then
				local wx, wz = T[2](-GRID.half + (i - 1) * GRID.step, z)
				local o = observed[cell(wz)][cell(wx)]
				total += 1
				if o == e then
					ok += 1
				end
				if WALKABLE[e] then
					ptotal += 1
					if WALKABLE[o] then
						pok += 1
					end
				end
			end
		end
	end
	table.insert(results, { t = t, score = ok / total, paths = pok / math.max(ptotal, 1) })
end
table.sort(results, function(a, b)
	if math.abs(a.score - b.score) > 1e-9 then
		return a.score > b.score
	end
	return a.t < b.t
end)
local best = results[1]
local T = TRANSFORMS[best.t][2]
out("Orientation: %s  (material match %.1f%%, paths %.1f%%; next best: %s %.1f%%)", TRANSFORMS[best.t][1],
	best.score * 100, best.paths * 100, TRANSFORMS[results[2].t][1], results[2].score * 100)
if best.score < 0.85 or best.paths < 0.85 then
	out("STOP: the terrain does not match the Pet Raiders layout well enough.")
	if best.paths < 0.5 then
		out("No paved paths found - was PetRaiders_Colormap.png selected as the Colormap during the import?")
	end
	out("Check the import Position (@@IMPORT_POS@@) and Size (@@IMPORT_SIZE@@), re-import, and run this again.")
	return finish()
end
if best.t ~= 1 then
	out("NOTE: the import landed %s. Markers below already account for that, so use the marker", TRANSFORMS[best.t][1])
	out("      positions / printed world coordinates rather than the numbers on the layout reference image.")
end

local ys = {}
for _, p in ipairs(PATHS) do
	for k = 1, #p.pts, 2 * 7 do
		local wx, wz = T(p.pts[k], p.pts[k + 1])
		local y = probe(wx, wz)
		if y then
			table.insert(ys, y)
		end
	end
end
table.sort(ys)
local groundY = ys[math.max(1, math.ceil(#ys / 2))]
out("Ground level: Y = %.2f  (0 if imported at Position Y 96; buildings should sit at this height)", groundY)

-- ------------------------------------------------------------------ 2. pastel material colours
if CONFIG.PASTEL_COLORS then
	local changed = {}
	for name, c in pairs(PASTEL) do
		local mat = Enum.Material[name]
		local old = terrain:GetMaterialColor(mat)
		terrain:SetMaterialColor(mat, c)
		table.insert(changed, string.format("%s %s -> %s", name, rgb(old), rgb(c)))
	end
	table.sort(changed)
	out("Material colours (old -> new): %s", table.concat(changed, "; "))
end
pcall(function()
	terrain.Decoration = CONFIG.GRASS_BLADES
end)
out("Grass blades (Terrain.Decoration): %s", tostring(CONFIG.GRASS_BLADES))

-- ------------------------------------------------------------------ 3. path / pad check
local function check(x, z)
	local wx, wz = T(x, z)
	local y, m = probe(wx, wz)
	if not y then
		return "no terrain", wx, wz
	end
	local c = CODE[m] or "?"
	if not WALKABLE[c] then
		return "material " .. m.Name, wx, wz, m
	end
	if math.abs(y - groundY) > 1.5 then
		return string.format("not flat (Y %.1f)", y), wx, wz
	end
	return nil, wx, wz
end

local function paint(wx, wz)
	local region = Region3.new(Vector3.new(wx - 3, groundY - 6, wz - 3), Vector3.new(wx + 3, groundY + 2, wz + 3))
		:ExpandToGrid(4)
	terrain:ReplaceMaterial(region, 4, Enum.Material.Grass, Enum.Material.Pavement)
	terrain:ReplaceMaterial(region, 4, Enum.Material.LeafyGrass, Enum.Material.Pavement)
end

local function runChecks(doPaint)
	local issues, samples, painted = {}, 0, 0
	local function note(label, why, wx, wz)
		table.insert(issues, string.format("%s at X %.0f Z %.0f: %s", label, wx, wz, why))
	end
	for _, p in ipairs(PATHS) do
		for k = 1, #p.pts, 2 do
			samples += 1
			local why, wx, wz, m = check(p.pts[k], p.pts[k + 1])
			if why then
				if doPaint and (m == Enum.Material.Grass or m == Enum.Material.LeafyGrass) then
					paint(wx, wz)
					painted += 1
				else
					note(p.name, why, wx, wz)
				end
			end
		end
	end
	for _, s in ipairs(STATIONS) do
		for k = 1, #s.probes, 2 do
			samples += 1
			local why, wx, wz = check(s.probes[k], s.probes[k + 1])
			if why then
				note(s.id .. " pad", why, wx, wz)
			end
		end
	end
	for _, e in ipairs(EGG_PADS) do
		samples += 1
		local why, wx, wz = check(e.x, e.z)
		if why then
			note("egg pad " .. e.name, why, wx, wz)
		end
	end
	return issues, samples, painted
end

local issues, samples, painted = runChecks(CONFIG.PAINT_PATH_GAPS)
if painted > 0 then
	out("Painted %d small grass gaps on path centre lines as Pavement.", painted)
	issues, samples = runChecks(false)
end
if #issues == 0 then
	out("Path check: %d samples on %d paths, %d station pads, %d egg pads - all paved, flat and connected.", samples,
		#PATHS, #STATIONS, #EGG_PADS)
else
	out("Path check: %d of %d samples have problems:", #issues, samples)
	for k = 1, math.min(#issues, 25) do
		out("  - %s", issues[k])
	end
	if #issues > 25 then
		out("  ... and %d more", #issues - 25)
	end
end

-- ------------------------------------------------------------------ 4. layout markers
local function part(name, size, cf, color, parent, transparency, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Locked = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Transparency = transparency or 0.35
	p.Size = size
	p.CFrame = cf
	p.Parent = parent
	return p
end

local function label(parent, text, color, height, w, h)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(w or 240, h or 52)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height or 16, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 4000
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundColor3 = color
	tl.BackgroundTransparency = 0.1
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.TextStrokeTransparency = 0.5
	tl.TextScaled = true
	pcall(function()
		tl.Font = Enum.Font.GothamBold
	end)
	tl.Text = text
	tl.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = tl
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = tl
	bb.Parent = parent
	return bb
end

local function disc(name, x, z, r, color, parent, transparency)
	return part(name, Vector3.new(0.4, 2 * r, 2 * r), CFrame.new(x, groundY + 0.3, z) * CFrame.Angles(0, 0, math.rad(90)),
		color, parent, transparency, Enum.PartType.Cylinder)
end

local old = workspace:FindFirstChild("PetRaidersLayout")
if old then
	old:Destroy()
end
local summary = {}
if CONFIG.MARKERS then
	local root = Instance.new("Folder")
	root.Name = "PetRaidersLayout"
	local fStations = Instance.new("Folder")
	fStations.Name = "Stations"
	fStations.Parent = root
	local fEggs = Instance.new("Folder")
	fEggs.Name = "EggPads"
	fEggs.Parent = root

	for _, s in ipairs(STATIONS) do
		local wx, wz = T(s.x, s.z)
		local color = Color3.fromRGB(s.color[1], s.color[2], s.color[3])
		local name = string.format("%02d_%s", s.n, s.id)
		local fx, fz = -wx, -wz -- facing: towards the plaza centre
		local fl = math.sqrt(fx * fx + fz * fz)
		if fl > 1e-6 then
			fx, fz = fx / fl, fz / fl
		end
		local marker, yawDeg, reach
		if s.r then
			marker = disc(name, wx, wz, s.r, color, fStations)
			yawDeg = 0
			reach = s.r
		else
			-- long side (sx) runs along the design axis rotated `rot` degrees from +X towards +Z
			local ux, uz = T(math.cos(math.rad(s.rot)), math.sin(math.rad(s.rot)))
			local yaw = math.atan(-uz, ux)
			yawDeg = math.floor(math.deg(yaw) * 10 + 0.5) / 10 + 0 -- (+ 0 turns -0 into 0)
			marker = part(name, Vector3.new(s.sx, 0.4, s.sz), CFrame.new(wx, groundY + 0.3, wz) * CFrame.Angles(0, yaw, 0),
				color, fStations)
			local vx, vz = -uz, ux
			local du, dv = math.abs(fx * ux + fz * uz), math.abs(fx * vx + fz * vz)
			reach = math.min(du > 1e-6 and (s.sx / 2) / du or math.huge, dv > 1e-6 and (s.sz / 2) / dv or math.huge)
			marker:SetAttribute("SizeX", s.sx)
			marker:SetAttribute("SizeZ", s.sz)
		end
		marker:SetAttribute("StationId", s.id)
		marker:SetAttribute("Number", s.n)
		marker:SetAttribute("DisplayName", s.name)
		marker:SetAttribute("Note", s.note)
		marker:SetAttribute("WorldX", wx)
		marker:SetAttribute("WorldZ", wz)
		marker:SetAttribute("GroundY", groundY)
		marker:SetAttribute("YawDeg", yawDeg)
		if s.r then
			marker:SetAttribute("Radius", s.r)
		end
		if s.front then
			marker:SetAttribute("FacingX", fx)
			marker:SetAttribute("FacingZ", fz)
			local front = disc("Front", wx + fx * (reach - 4), wz + fz * (reach - 4), 3, Color3.new(1, 1, 1), marker, 0.1)
			label(front, "front", Color3.fromRGB(60, 60, 70), 4, 70, 24)
		end
		local pole = part("Pole", Vector3.new(0.8, 12, 0.8), CFrame.new(wx, groundY + 6, wz), color, marker, 0.15)
		label(pole, string.format("%d  %s", s.n, s.name), color, 12)
		table.insert(summary, string.format("  %2d %-13s X %7.1f  Z %7.1f  %s", s.n, s.id, wx, wz,
			s.r and string.format("pad r=%d", s.r) or string.format("pad %dx%d, yaw %.1f deg", s.sx, s.sz, yawDeg)))
	end
	for _, e in ipairs(EGG_PADS) do
		local wx, wz = T(e.x, e.z)
		local m = disc(e.name, wx, wz, e.r, Color3.fromRGB(255, 160, 200), fEggs)
		m:SetAttribute("StationId", e.name)
		m:SetAttribute("WorldX", wx)
		m:SetAttribute("WorldZ", wz)
		m:SetAttribute("GroundY", groundY)
		m:SetAttribute("Radius", e.r)
		label(m, e.name, Color3.fromRGB(214, 84, 140), 8, 60, 30)
		table.insert(summary, string.format("  %-16s X %7.1f  Z %7.1f  pad r=%d", e.name, wx, wz, e.r))
	end
	root:SetAttribute("GroundY", groundY)
	root:SetAttribute("Orientation", TRANSFORMS[best.t][1])
	root.Parent = workspace
	out("Markers: Workspace.PetRaidersLayout (%d stations, %d egg pads). Delete the folder when the buildings are placed.",
		#STATIONS, #EGG_PADS)
end

-- ------------------------------------------------------------------ 5. boundary walls
local oldB = workspace:FindFirstChild("PetRaidersBoundary")
if oldB then
	oldB:Destroy()
end
if CONFIG.BOUNDARY_WALLS then
	local B, H, CUT = CONFIG.BOUNDARY_HALF, CONFIG.WALL_HEIGHT, 70
	local folder = Instance.new("Folder")
	folder.Name = "PetRaidersBoundary"
	local y = groundY - 30 + H / 2
	local function wall(name, cx, cz, length, ux, uz)
		local w = part(name, Vector3.new(length, H, 4), CFrame.new(cx, y, cz) * CFrame.Angles(0, math.atan(-uz, ux), 0),
			Color3.fromRGB(255, 255, 255), folder, 1)
		w.CanCollide = true
		return w
	end
	local L = 2 * (B - CUT) + 4
	wall("Wall_North", 0, -(B + 2), L, 1, 0)
	wall("Wall_South", 0, B + 2, L, 1, 0)
	wall("Wall_West", -(B + 2), 0, L, 0, 1)
	wall("Wall_East", B + 2, 0, L, 0, 1)
	local d = CUT * math.sqrt(2) + 6
	for _, sxz in ipairs({ { 1, 1, "SE" }, { -1, 1, "SW" }, { 1, -1, "NE" }, { -1, -1, "NW" } }) do
		local sx, sz = sxz[1], sxz[2]
		local cx, cz = sx * (B - CUT / 2 + 1.4), sz * (B - CUT / 2 + 1.4)
		wall("Wall_" .. sxz[3], cx, cz, d, -sx / math.sqrt(2), sz / math.sqrt(2))
	end
	folder.Parent = workspace
	out("Boundary: Workspace.PetRaidersBoundary (8 invisible walls, %d studs from the centre).", B)
end

if #summary > 0 then
	out("World positions (stand each building's centre here, bottom on Y = %.1f):", groundY)
	for _, s in ipairs(summary) do
		out(s)
	end
end
out("Done. Ctrl+Z undoes this script's changes.")
return finish()
